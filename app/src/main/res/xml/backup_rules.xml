<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 11 and earlier. Backup is off (allowBackup="false"); these rules also exclude
   everything in case a device ignores that flag (M1-10, audit R6).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
