<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Window theme only; Compose draws everything inside. AppCompat because MainActivity is an
        AppCompatActivity, as in Secret Calculator (M2-07). DayNight with a matching background, so
        launch shows the right colour in light and dark (M3-05).
    -->
    <style name="Theme.FlipToMute" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
